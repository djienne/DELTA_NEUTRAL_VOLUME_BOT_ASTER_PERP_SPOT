# Copy to aster.env (git-ignored) and fill in. Never commit aster.env.
# Every value is shown only once on Aster, when you create the key.

# Pro API (perpetual, v3): More -> API Management -> Pro API
API_USER=0xYOUR_WALLET_ADDRESS_HERE
API_SIGNER=0xGENERATED_SIGNER_ADDRESS_HERE
API_PRIVATE_KEY=0xGENERATED_PRIVATE_KEY_64_HEX_CHARS

# API (spot, v1): More -> API Management -> API
APIV1_PUBLIC_KEY=your_apiv1_public_key_here
APIV1_PRIVATE_KEY=your_apiv1_private_key_here
